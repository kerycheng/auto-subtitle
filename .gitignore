# Publish only source, synthetic unit tests, build tools and public documentation.
# Private media, project caches, models, reports and local notes stay on this machine.
/*
!/.editorconfig
!/.gitattributes
!/.gitignore
!/LICENSE
!/README.md
!/CONTRIBUTING.md
!/Start-AutoSubtitle.cmd
!/pyproject.toml
!/requirements-windows-py312.lock
!/requirements-alignment-windows-py312.lock
!/src/
!/scripts/
!/tests/
!/docs/
/docs/*
!/docs/windows-quickstart.txt
!/docs/timing-rules.md
!/docs/release-notes-v0.10.0.md
!/docs/images/
/docs/images/*
!/docs/images/main-window.svg
!/docs/images/vocabulary-selection.svg
!/docs/images/timing-settings.svg
__pycache__/
*.py[cod]
*.egg-info/
*.autosub.json*
*.invalid.bak
*.error.log
*.cache/
*.review/
*.comparison.json
*.wav
*.mp3
*.mp4
*.mkv
*.webm
*.flac
*.ass
*.srt
*.vtt
.env
.env.*
*.pem
*.key

# Local case studies and historical diagnostics (kept locally, never published).
/scripts/compare_retiming.py
/scripts/diagnose_timing.py
/scripts/prepare_edge_context_study.py
/scripts/report_phase12.py
/scripts/report_clip_context_feedback.py
/scripts/report_backend_feedback.py
/scripts/report_edge_context_study.py
/scripts/validate_native_guard.py
/scripts/validate_native_pipeline.py
/scripts/validate_review_proposals.py
!/AGENTS.md
